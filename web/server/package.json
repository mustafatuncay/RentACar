    "@fastify/jwt": "9.1.0",
    "@fastify/static": "8.3.0",
    "bcryptjs": "3.0.3",
    "fast-xml-parser": "4.5.7",
    "fastify": "5.12.8",
    "mysql2": "3.24.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
