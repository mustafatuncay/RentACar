# RentACar PWA sunucu ayarları. Bu dosyayı .env olarak kopyalayıp doldurun.
# .env dosyasını asla git'e eklemeyin.

PORT=3000
HOST=127.0.0.1

# MySQL (aynı sunucuda). root kullanmayın, sadece RentACar veritabanına yetkili bir kullanıcı açın.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rentacar_app
DB_PASSWORD=
DB_NAME=RentACar

# Oturum anahtarı: en az 32 karakter rastgele bir değer.
# Örnek üretim:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Oturum süresi (saat). Eski programda 33 dk boşta kalınca kapanıyordu.
SESSION_HOURS=10

# Eski Delphi programı hâlâ kullanılıyorsa true bırakın:
# web'den şifre değiştirildiğinde eski 'password' kolonu da güncellenir (Delphi girişi için).
# Delphi kullanımı bitince false yapın; o zaman sadece hash saklanır.
LEGACY_PLAINTEXT_PASSWORDS=true

# Döviz kurları (KKTC Merkez Bankası günlük XML)
KUR_XML_URL=https://www.mb.gov.ct.tr/kur/gunluk.xml

# Derlenmiş PWA dosyalarının yolu (client/dist)
CLIENT_DIST=../client/dist
